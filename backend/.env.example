# Server
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

EXTERNAL_API_BASE_URL=https://us1.locationiq.com/v1
EXTERNAL_API_KEY={your-key}
EXTERNAL_API_KEY_PARAM_NAME=key
EXTERNAL_API_TIMEOUT_SECONDS=10

LOG_LEVEL=DEBUG   # see every outgoing request while diagnosing an issue
#LOG_LEVEL=INFO    # default — successes + failures
#LOG_LEVEL=WARNING # failures only

ISOCHRONE_API_KEY={your-key}